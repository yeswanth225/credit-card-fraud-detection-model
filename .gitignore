# Dependencies and virtual environments
node_modules/
**/node_modules/
venv/
.venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Frontend build output
frontend/dist/
frontend/build/
frontend/.next/
frontend/.vite/
dist/
build/
.next/
.vite/

# Local environment and secrets
.env
.env.*
!.env.example
!.env.sample

# Logs and temporary files
logs/
*.log
tmp/
temp/
.cache/

# Generated or local-only dataset files
# Keep required processed model artifacts and notebooks tracked
# unless they are deliberately local-only files.
data/raw/*.csv
data/processed/*.parquet
data/processed/*.csv
data/processed/*.pkl

# Notebook checkpoints only
**/.ipynb_checkpoints/

# OS and editor metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Databases
*.db
*.sqlite
*.sqlite3

# Machine learning generated folders
mlruns/
runs/
